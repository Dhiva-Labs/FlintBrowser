# Maintainer: Dhiva Labs <dhivakar1010@gmail.com>
#
# AUR package. It repackages the .deb from the GitHub release, so Arch users
# run the same build as every other distribution. packaging/arch/aur.sh
# renders this file for each release (version and checksums) and checks it
# with makepkg; the rendered PKGBUILD and .SRCINFO are what gets pushed to
# the AUR.
pkgname=@NAME@-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='@SUMMARY@'
arch=('x86_64' 'aarch64')
url='@HOMEPAGE@'
license=('@LICENSE@')
depends=(@ARCH_DEPENDS@)
provides=('@NAME@')
conflicts=('@NAME@')
options=('!strip' '!debug')
source=("LICENSE-$pkgver::https://raw.githubusercontent.com/@GITHUB_REPO@/@TAG@/LICENSE")
source_x86_64=("@RELEASE_URL@/@DEB_AMD64@")
source_aarch64=("@RELEASE_URL@/@DEB_ARM64@")
sha256sums=('@SHA_LICENSE@')
sha256sums_x86_64=('@SHA_AMD64@')
sha256sums_aarch64=('@SHA_ARM64@')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  rm -rf "$pkgdir/usr/share/lintian"
  if [ -d "$pkgdir/usr/share/doc" ]; then
    find "$pkgdir/usr/share/doc" -name changelog.Debian.gz -delete
  fi
  # What the .deb's maintainer script sets up at install time: the command
  # on PATH, and Chromium's setuid sandbox helper for kernels without
  # unprivileged user namespaces.
  install -d "$pkgdir/usr/bin"
  ln -s "/opt/@PRODUCT@/@NAME@" "$pkgdir/usr/bin/@NAME@"
  chmod 4755 "$pkgdir/opt/@PRODUCT@/chrome-sandbox"
  install -Dm644 "LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
