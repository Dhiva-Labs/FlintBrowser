#!/usr/bin/make -f
# @NAME@ ships a prebuilt Electron bundle, so there is nothing to compile:
# we simply install the payload tree. Electron cannot be built on Launchpad's
# builders, so a from-source build is intentionally not used.

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:

override_dh_auto_install:
	mkdir -p debian/@PKG@
	cp -a opt usr debian/@PKG@/

# The bundled Electron binary and libraries are private to the app and must
# not be scanned for system dependencies, stripped or recompressed.
override_dh_shlibdeps:
override_dh_strip:
override_dh_strip_nondeterminism:
override_dh_dwz:
